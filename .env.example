# Public Firebase Web configuration, copied from the EXISTING nurture-12398 web app.
# This config identifies the project; Firebase Security Rules enforce authorization.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=nurture-12398
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Enable locally only; never points to another Firebase project.
VITE_USE_FIREBASE_EMULATORS=false
# Set only AFTER confirming the corresponding provider is configured in Firebase.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_ANONYMOUS_ENABLED=false
# Never put Stripe/Twilio/SendGrid/Admin secrets in ANY VITE_ variable.
